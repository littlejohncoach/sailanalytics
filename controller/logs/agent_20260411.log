# -----------------------------
# LOGGING
# -----------------------------
def log_event(kind: str, payload: Any) -> None:
    ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    try:
        with open(LOG_FILE, "a", encoding="utf-8") as f:
            f.write(f"[{ts}] {kind}: ")
            if isinstance(payload, str):
                f.write(payload)
            else:
                f.write(json.dumps(payload, ensure_ascii=False, default=str))
            f.write("\n")
    except Exception:
        pass


# -----------------------------
# PATH SAFETY
# -----------------------------
def safe_path(path: str) -> str:
    if path is None:
        path = "."
    path = str(path).strip() or "."
    full = os.path.abspath(os.path.join(ROOT, path))
    if os.path.commonpath([ROOT, full]) != ROOT:
        raise ValueError("Path outside root not allowed")
    return full


def rel_root(path: str) -> str:
    return os.path.relpath(path, ROOT)


# -----------------------------
# MEMORY
# -----------------------------
def load_memory() -> Dict[str, Any]:
    memory: Dict[str, Any] = {}
    if not os.path.isdir(MEMORY_DIR):
        return memory

    for name in sorted(os.listdir(MEMORY_DIR)):
        if not name.endswith(".json"):
            continue
        full = os.path.join(MEMORY_DIR, name)
        key = name[:-5]
        try:
            with open(full, "r", encoding="utf-8") as f:
                memory[key] = json.load(f)
        except Exception as e:
            memory[key] = {"_error": str(e), "_path": rel_root(full)}
    return memory


# -----------------------------
# FILE HELPERS
# -----------------------------
def file_line_count(path: str) -> Optional[int]:
    try:
        with open(path, "r", encoding="utf-8", errors="ignore") as f:
            return sum(1 for _ in f)
    except Exception:
        return None


def csv_row_count(path: str) -> Optional[int]:
    try:
        with open(path, "r", encoding="utf-8", errors="ignore", newline="") as f:
            reader = csv.reader(f)
            rows = sum(1 for _ in reader)
            return max(rows - 1, 0)
    except Exception:
        return None


def csv_columns_fast(path: str) -> List[str]:
    try:
        with open(path, "r", encoding="utf-8", errors="ignore", newline="") as f:
            reader = csv.reader(f)
            header = next(reader, [])
            return [str(x) for x in header]
    except Exception:
        return []


def infer_race_id_from_filename(path: str) -> Optional[str]:
    base = os.path.basename(path)
    name, _ = os.path.splitext(base)

    if name.startswith("geometry_"):
        return name.replace("geometry_", "", 1)

    m = re.search(r"_(\d{6}_R\d+(?:_[A-Za-z0-9-]+)?)$", name)
    if m:
        return m.group(1)

    return None


