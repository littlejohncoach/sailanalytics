class AgentApp:
    def __init__(self, root: tk.Tk):
        self.root = root
        self.root.title("VREA Local Analyst")
        self.root.geometry("1100x760")

        self.status_var = tk.StringVar(value=f"Ready | model={MODEL}")
        self.job_queue: "queue.Queue[tuple[str, str]]" = queue.Queue()

        self._build_ui()
        self.root.after(100, self._process_ui_queue)

    def _build_ui(self) -> None:
        top = tk.Frame(self.root)
        top.pack(fill="x", padx=10, pady=(10, 6))

        tk.Label(top, text="Question", font=("Arial", 12, "bold")).pack(anchor="w")
        self.input_box = scrolledtext.ScrolledText(top, height=7, wrap=tk.WORD)
        self.input_box.pack(fill="x", pady=(4, 8))

        button_row = tk.Frame(top)
        button_row.pack(fill="x")

        self.ask_button = tk.Button(button_row, text="Ask", width=12, command=self.start_ask)
        self.ask_button.pack(side="left")

        self.speak_button = tk.Button(button_row, text="Speak", width=12, command=self.start_speak)
        self.speak_button.pack(side="left", padx=(8, 0))

        self.clear_button = tk.Button(button_row, text="Clear", width=12, command=self.clear_output)
        self.clear_button.pack(side="left", padx=(8, 0))

        self.scan_button = tk.Button(button_row, text="Repo Summary", width=14, command=self.insert_repo_summary_prompt)
        self.scan_button.pack(side="left", padx=(8, 0))

        tk.Label(self.root, text="Answer", font=("Arial", 12, "bold")).pack(anchor="w", padx=10)
        self.output_box = scrolledtext.ScrolledText(self.root, wrap=tk.WORD)
        self.output_box.pack(fill="both", expand=True, padx=10, pady=(4, 8))

        status = tk.Label(self.root, textvariable=self.status_var, anchor="w", relief="sunken")
        status.pack(fill="x", side="bottom")

    def set_status(self, text: str) -> None:
        self.status_var.set(text)

    def clear_output(self) -> None:
        self.output_box.delete("1.0", tk.END)

    def set_output(self, text: str) -> None:
        self.output_box.delete("1.0", tk.END)
        self.output_box.insert(tk.END, text)

    def append_output(self, text: str) -> None:
        self.output_box.insert(tk.END, text)
        self.output_box.see(tk.END)

    def insert_repo_summary_prompt(self) -> None:
        self.input_box.delete("1.0", tk.END)
        self.input_box.insert(
            tk.END,
            "Summarize the repository structure first, then tell me the important data folders, analytics routes, and race-linked file conventions currently present.",
        )

    def start_ask(self) -> None:
        question = self.input_box.get("1.0", tk.END).strip()
        if not question:
            messagebox.showinfo("No question", "Type a question first.")
            return

        self.ask_button.config(state="disabled")
        self.speak_button.config(state="disabled")
        self.set_status("Running...")
        self.set_output("Working...\n")

        def worker() -> None:
            try:
                answer = ask(question)
                self.job_queue.put(("answer", answer))
            except Exception as e:
                self.job_queue.put(("answer", f"Error: {e}"))
            finally:
                self.job_queue.put(("status", f"Ready | model={MODEL}"))
                self.job_queue.put(("buttons", "enable"))

        threading.Thread(target=worker, daemon=True).start()

    def start_speak(self) -> None:
        if sr is None:
            messagebox.showerror("Speech unavailable", "speech_recognition is not installed in this environment.")
            return

        self.ask_button.config(state="disabled")
        self.speak_button.config(state="disabled")
        self.set_status("Listening...")
        self.set_output("Listening...\n")

        def worker() -> None:
            recognizer = sr.Recognizer()
            try:
                with sr.Microphone() as source:
                    recognizer.adjust_for_ambient_noise(source, duration=0.5)
                    audio = recognizer.listen(source, timeout=10, phrase_time_limit=20)
                text = recognizer.recognize_google(audio)
                self.job_queue.put(("speech_text", text))
                answer = ask(text)
                self.job_queue.put(("answer", answer))
            except Exception as e:
                self.job_queue.put(("answer", f"Error: {e}"))
            finally:
                self.job_queue.put(("status", f"Ready | model={MODEL}"))
                self.job_queue.put(("buttons", "enable"))

        threading.Thread(target=worker, daemon=True).start()

    def _process_ui_queue(self) -> None:
        try:
            while True:
                kind, payload = self.job_queue.get_nowait()
                if kind == "answer":
                    self.set_output(payload)
                elif kind == "status":
                    self.set_status(payload)
                elif kind == "buttons":
                    self.ask_button.config(state="normal")
                    self.speak_button.config(state="normal")
                elif kind == "speech_text":
                    self.input_box.delete("1.0", tk.END)
                    self.input_box.insert(tk.END, payload)
                    self.set_output(f"Heard: {payload}\n\nWorking...\n")
        except queue.Empty:
            pass
        self.root.after(100, self._process_ui_queue)


def main() -> None:
    app_root = tk.Tk()
    AgentApp(app_root)
    app_root.mainloop()


if __name__ == "__main__":
    main()
