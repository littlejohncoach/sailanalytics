        "name": "find_files",
        "description": "Find files by glob pattern under a given path.",
        "parameters": {
            "type": "object",
            "properties": {
                "path": {"type": "string"},
                "pattern": {"type": "string"},
            },
            "required": [],
            "additionalProperties": False,
        },
    },
    {
        "type": "function",
        "name": "stat_file",
        "description": "Return file metadata, row count estimates for CSVs, and line counts for text files.",
        "parameters": {
