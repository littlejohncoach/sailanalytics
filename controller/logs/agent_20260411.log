if not API_KEY:
    raise RuntimeError(
        "OPENAI_API_KEY is missing. Put it in controller/.env or export it in your shell."
    )

client = OpenAI(api_key=API_KEY)

# -----------------------------
# GENERAL CONFIG
# -----------------------------
MAX_TEXT_CHARS = int(os.getenv("AGENT_MAX_TEXT_CHARS", "30000"))
DEFAULT_SCAN_DEPTH = int(os.getenv("AGENT_SCAN_DEPTH", "4"))
CSV_SAMPLE_ROWS = int(os.getenv("AGENT_CSV_SAMPLE_ROWS", "5"))
CSV_TAIL_SAMPLE_ROWS = int(os.getenv("AGENT_CSV_TAIL_SAMPLE_ROWS", "3"))
LOG_FILE = os.path.join(LOG_DIR, f"agent_{datetime.now().strftime('%Y%m%d')}.log")

SYSTEM_PROMPT = """
You are VREA, a read-only local analytics agent for the SailAnalytics repository.

Rules:
- Treat the local filesystem as the source of truth.
- Never assume files exist. Verify with tools first.
- Read memory first for project context.
- Prefer scan_tree, find_files, stat_file, summarize_repo, and get_race_files before answering repository questions.
- For CSV reasoning, inspect schema before drawing conclusions.
- Use run_python only for computation on verified data. Do not invent paths or columns.
- Do not request or perform file writes, deletes, renames, shell commands, or system changes.
- Be explicit about which file, function, route, columns, and formulas are used when asked.
- If information is missing, say exactly what is missing.
""".strip()


# -----------------------------
# LOGGING
# -----------------------------
def log_event(kind: str, payload: Any) -> None:
    ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    try:
        with open(LOG_FILE, "a", encoding="utf-8") as f:
            f.write(f"[{ts}] {kind}: ")
            if isinstance(payload, str):
                f.write(payload)
            else:
                f.write(json.dumps(payload, ensure_ascii=False, default=str))
            f.write("\n")
    except Exception:
        pass


# -----------------------------
# PATH SAFETY
# -----------------------------
def safe_path(path: str) -> str:
    if path is None:
        path = "."
    path = str(path).strip() or "."
    full = os.path.abspath(os.path.join(ROOT, path))
    if os.path.commonpath([ROOT, full]) != ROOT:
        raise ValueError("Path outside root not allowed")
    return full


def rel_root(path: str) -> str:
    return os.path.relpath(path, ROOT)


# -----------------------------
# MEMORY
# -----------------------------
def load_memory() -> Dict[str, Any]:
    memory: Dict[str, Any] = {}
    if not os.path.isdir(MEMORY_DIR):
        return memory

    for name in sorted(os.listdir(MEMORY_DIR)):
        if not name.endswith(".json"):
            continue
        full = os.path.join(MEMORY_DIR, name)
        key = name[:-5]
        try:
            with open(full, "r", encoding="utf-8") as f:
                memory[key] = json.load(f)
        except Exception as e:
            memory[key] = {"_error": str(e), "_path": rel_root(full)}
    return memory


# -----------------------------
# FILE HELPERS
# -----------------------------
def file_line_count(path: str) -> Optional[int]:
    try:
        with open(path, "r", encoding="utf-8", errors="ignore") as f:
            return sum(1 for _ in f)
    except Exception:
        return None


def csv_row_count(path: str) -> Optional[int]:
    try:
        with open(path, "r", encoding="utf-8", errors="ignore", newline="") as f:
            reader = csv.reader(f)
            rows = sum(1 for _ in reader)
            return max(rows - 1, 0)
    except Exception:
        return None


def csv_columns_fast(path: str) -> List[str]:
    try:
        with open(path, "r", encoding="utf-8", errors="ignore", newline="") as f:
            reader = csv.reader(f)
            header = next(reader, [])
            return [str(x) for x in header]
    except Exception:
        return []


def infer_race_id_from_filename(path: str) -> Optional[str]:
    base = os.path.basename(path)
    name, _ = os.path.splitext(base)

    if name.startswith("geometry_"):
        return name.replace("geometry_", "", 1)

    m = re.search(r"_(\d{6}_R\d+(?:_[A-Za-z0-9-]+)?)$", name)
    if m:
        return m.group(1)

    return None


# -----------------------------
# TOOLS
# -----------------------------
def tool_read_memory() -> str:
    return json.dumps(load_memory(), indent=2, ensure_ascii=False, default=str)


def tool_list_dir(path: str = ".") -> str:
    full = safe_path(path)
    if not os.path.isdir(full):
        raise ValueError(f"Not a directory: {path}")

    items: List[Dict[str, Any]] = []
    for name in sorted(os.listdir(full)):
        p = os.path.join(full, name)
        try:
            st = os.stat(p)
            items.append(
                {
                    "name": name,
                    "path": rel_root(p),
                    "type": "dir" if os.path.isdir(p) else "file",
                    "ext": os.path.splitext(name)[1].lower() if os.path.isfile(p) else "",
                    "size": st.st_size,
                    "mtime": datetime.fromtimestamp(st.st_mtime).isoformat(timespec="seconds"),
                }
            )
        except Exception as e:
            items.append({"name": name, "path": rel_root(p), "error": str(e)})
    return json.dumps({"path": path, "items": items}, indent=2, ensure_ascii=False)


def tool_scan_tree(path: str = ".", max_depth: int = DEFAULT_SCAN_DEPTH) -> str:
    base = safe_path(path)
    out: List[Dict[str, Any]] = []
    base_depth = base.count(os.sep)

    for current, dirs, files in os.walk(base):
        current_depth = current.count(os.sep) - base_depth
        if current_depth >= max_depth:
            dirs[:] = []

        for d in sorted(dirs):
            p = os.path.join(current, d)
            try:
                st = os.stat(p)
                out.append(
                    {
                        "path": rel_root(p),
                        "type": "dir",
                        "size": st.st_size,
                        "mtime": datetime.fromtimestamp(st.st_mtime).isoformat(timespec="seconds"),
                    }
                )
            except Exception as e:
                out.append({"path": rel_root(p), "type": "dir", "error": str(e)})

        for f_name in sorted(files):
            p = os.path.join(current, f_name)
            try:
                st = os.stat(p)
                out.append(
                    {
                        "path": rel_root(p),
                        "type": "file",
                        "ext": os.path.splitext(f_name)[1].lower(),
                        "size": st.st_size,
                        "mtime": datetime.fromtimestamp(st.st_mtime).isoformat(timespec="seconds"),
                    }
                )
            except Exception as e:
                out.append({"path": rel_root(p), "type": "file", "error": str(e)})

    return json.dumps(
        {"root": path, "max_depth": max_depth, "items": out},
        indent=2,
        ensure_ascii=False,
    )


def tool_find_files(path: str = ".", pattern: str = "*") -> str:
    base = safe_path(path)
    matches = glob.glob(os.path.join(base, "**", pattern), recursive=True)
    items = sorted(rel_root(m) for m in matches)
    return json.dumps(
        {"path": path, "pattern": pattern, "count": len(items), "matches": items},
        indent=2,
        ensure_ascii=False,
    )


def tool_stat_file(path: str) -> str:
    full = safe_path(path)
    exists = os.path.exists(full)
    if not exists:
        return json.dumps({"path": path, "exists": False}, indent=2, ensure_ascii=False)

    st = os.stat(full)
    is_dir = os.path.isdir(full)
    ext = os.path.splitext(full)[1].lower() if not is_dir else ""

    payload: Dict[str, Any] = {
        "path": rel_root(full),
        "exists": True,
        "is_dir": is_dir,
        "size": st.st_size,
        "mtime": datetime.fromtimestamp(st.st_mtime).isoformat(timespec="seconds"),
        "ext": ext,
    }

    if not is_dir:
        payload["line_count"] = file_line_count(full)
        if ext == ".csv":
            payload["row_count"] = csv_row_count(full)
            payload["columns"] = csv_columns_fast(full)

    return json.dumps(payload, indent=2, ensure_ascii=False)


def tool_read_text_file(path: str, max_chars: int = MAX_TEXT_CHARS) -> str:
    full = safe_path(path)
    if os.path.isdir(full):
        return tool_list_dir(path)

    with open(full, "r", encoding="utf-8", errors="ignore") as f:
        text = f.read(max_chars + 1)

    truncated = len(text) > max_chars
    if truncated:
        text = text[:max_chars]

    return json.dumps(
        {
            "path": rel_root(full),
            "truncated": truncated,
            "max_chars": max_chars,
            "content": text,
        },
        indent=2,
        ensure_ascii=False,
    )


def tool_inspect_csv(path: str, sample_rows: int = CSV_SAMPLE_ROWS) -> str:
    full = safe_path(path)
    if not os.path.isfile(full):
        raise ValueError(f"Not a file: {path}")
    if not full.lower().endswith(".csv"):
        raise ValueError(f"Not a CSV file: {path}")

    row_count = csv_row_count(full)
    try:
        df_head = pd.read_csv(full, nrows=sample_rows, engine="python", on_bad_lines="skip")
    except Exception as e:
        return json.dumps({"path": rel_root(full), "error": str(e)}, indent=2, ensure_ascii=False)

    dtypes = {col: str(dtype) for col, dtype in df_head.dtypes.items()}
    columns = list(df_head.columns)

    null_counts: Dict[str, Any] = {}
    try:
        df_sample = pd.read_csv(full, engine="python", on_bad_lines="skip")
        null_counts = df_sample.isnull().sum().to_dict()
        dtypes = {col: str(dtype) for col, dtype in df_sample.dtypes.items()}
        tail_sample = df_sample.tail(CSV_TAIL_SAMPLE_ROWS).to_dict(orient="records")
    except Exception:
        tail_sample = []

    payload = {
        "path": rel_root(full),
        "rows": row_count,
        "columns": columns,
        "dtypes": dtypes,
        "nulls": null_counts,
        "head_sample": df_head.head(sample_rows).to_dict(orient="records"),
        "tail_sample": tail_sample,
    }
    return json.dumps(payload, indent=2, ensure_ascii=False, default=str)


def tool_summarize_repo(path: str = ".", max_depth: int = DEFAULT_SCAN_DEPTH) -> str:
    base = safe_path(path)

    ext_counts: Dict[str, int] = {}
    dir_counts: Dict[str, int] = {}
    race_ids: Dict[str, Dict[str, int]] = {}

    for current, dirs, files in os.walk(base):
        rel_dir = rel_root(current)
        depth = 0 if rel_dir == "." else rel_dir.count(os.sep) + 1
        if depth > max_depth:
            dirs[:] = []
            continue

        dir_counts[rel_dir] = dir_counts.get(rel_dir, 0) + len(files)

        for name in files:
            ext = os.path.splitext(name)[1].lower() or "<none>"
            ext_counts[ext] = ext_counts.get(ext, 0) + 1

            full = os.path.join(current, name)
            rid = infer_race_id_from_filename(full)
            if rid:
                bucket = race_ids.setdefault(rid, {"totalraces": 0, "geometry": 0, "other": 0})
                rel = rel_root(full)
                if rel.startswith("data/totalraces/"):
                    bucket["totalraces"] += 1
                elif rel.startswith("data/geometry/"):
                    bucket["geometry"] += 1
                else:
                    bucket["other"] += 1

    missing_geometry = sorted(rid for rid, v in race_ids.items() if v["totalraces"] > 0 and v["geometry"] == 0)
    missing_totalraces = sorted(rid for rid, v in race_ids.items() if v["geometry"] > 0 and v["totalraces"] == 0)

    payload = {
        "root": rel_root(base),
        "max_depth": max_depth,
        "file_counts_by_extension": dict(sorted(ext_counts.items())),
        "file_counts_by_directory": dict(sorted(dir_counts.items())),
        "race_ids_found": len(race_ids),
        "missing_geometry_for_race_ids": missing_geometry,
        "missing_totalraces_for_race_ids": missing_totalraces,
        "race_id_summary_sample": dict(sorted(race_ids.items())[:50]),
    }
    return json.dumps(payload, indent=2, ensure_ascii=False)


def tool_get_race_files(race_id: str) -> str:
    race_id = str(race_id).strip()
    if not race_id:
        raise ValueError("race_id is required")

    totalraces = sorted(rel_root(p) for p in glob.glob(os.path.join(ROOT, "data", "totalraces", f"*_{race_id}.csv")))
    tapes = sorted(rel_root(p) for p in glob.glob(os.path.join(ROOT, "data", "tapes", f"*_{race_id}.csv")))
    geometry = sorted(rel_root(p) for p in glob.glob(os.path.join(ROOT, "data", "geometry", f"geometry_{race_id}.csv")))
    marks = sorted(rel_root(p) for p in glob.glob(os.path.join(ROOT, "data", "marks", f"*{race_id}*")))
    ready = sorted(rel_root(p) for p in glob.glob(os.path.join(ROOT, "data", "ready", f"*{race_id}*")))

    payload = {
        "race_id": race_id,
        "geometry": geometry,
        "totalraces": totalraces,
        "tapes": tapes,
        "marks": marks,
        "ready": ready,
    }
    return json.dumps(payload, indent=2, ensure_ascii=False)


# -----------------------------
# SAFE ANALYSIS PYTHON
# -----------------------------
ALLOWED_BUILTINS: Dict[str, Any] = {
    "len": len,
    "min": min,
    "max": max,
    "sum": sum,
    "sorted": sorted,
    "enumerate": enumerate,
    "range": range,
    "zip": zip,
    "list": list,
    "dict": dict,
    "set": set,
    "tuple": tuple,
    "abs": abs,
    "round": round,
    "print": print,
    "any": any,
    "all": all,
}

BLOCKED_NAMES = {
    "open",
    "exec",
    "eval",
    "compile",
    "input",
    "help",
    "breakpoint",
    "__import__",
    "globals",
    "locals",
    "vars",
    "dir",
    "getattr",
    "setattr",
    "delattr",
}

BLOCKED_ATTRS = {
    "system",
    "popen",
    "remove",
    "unlink",
    "rmdir",
    "rename",
    "replace",
    "mkdir",
    "makedirs",
    "rmtree",
    "to_csv",
    "to_excel",
    "to_json",
    "dump",
    "dumps",
    "save",
    "write",
}

BLOCKED_NODES = (
    ast.Import,
    ast.ImportFrom,
    ast.With,
    ast.AsyncWith,
    ast.Try,
    ast.Raise,
    ast.ClassDef,
    ast.AsyncFunctionDef,
    ast.Delete,
    ast.Global,
    ast.Nonlocal,
    ast.Lambda,
)


def validate_analysis_code(code: str) -> None:
    tree = ast.parse(code, mode="exec")
    for node in ast.walk(tree):
        if isinstance(node, BLOCKED_NODES):
            raise ValueError(f"Blocked syntax: {type(node).__name__}")
        if isinstance(node, ast.Name) and node.id in BLOCKED_NAMES:
            raise ValueError(f"Blocked name: {node.id}")
        if isinstance(node, ast.Attribute) and node.attr in BLOCKED_ATTRS:
            raise ValueError(f"Blocked attribute: {node.attr}")


def tool_run_python(code: str) -> str:
    validate_analysis_code(code)

    stdout = io.StringIO()
    local_vars: Dict[str, Any] = {}
    safe_globals: Dict[str, Any] = {
        "__builtins__": ALLOWED_BUILTINS,
        "pd": pd,
        "json": json,
        "math": math,
        "ROOT": ROOT,
        "safe_path": safe_path,
    }

    with contextlib.redirect_stdout(stdout):
        exec(code, safe_globals, local_vars)

    payload = {
        "stdout": stdout.getvalue(),
        "result": local_vars.get("result"),
    }
    return json.dumps(payload, indent=2, ensure_ascii=False, default=str)


# -----------------------------
# TOOL REGISTRY
# -----------------------------
TOOL_IMPLS = {
    "read_memory": lambda **kwargs: tool_read_memory(),
    "list_dir": lambda path=".", **kwargs: tool_list_dir(path=path),
    "scan_tree": lambda path=".", max_depth=DEFAULT_SCAN_DEPTH, **kwargs: tool_scan_tree(path=path, max_depth=int(max_depth)),
    "find_files": lambda path=".", pattern="*", **kwargs: tool_find_files(path=path, pattern=pattern),
    "stat_file": lambda path, **kwargs: tool_stat_file(path=path),
    "read_text_file": lambda path, max_chars=MAX_TEXT_CHARS, **kwargs: tool_read_text_file(path=path, max_chars=int(max_chars)),
    "inspect_csv": lambda path, sample_rows=CSV_SAMPLE_ROWS, **kwargs: tool_inspect_csv(path=path, sample_rows=int(sample_rows)),
    "summarize_repo": lambda path=".", max_depth=DEFAULT_SCAN_DEPTH, **kwargs: tool_summarize_repo(path=path, max_depth=int(max_depth)),
    "get_race_files": lambda race_id, **kwargs: tool_get_race_files(race_id=race_id),
    "run_python": lambda code, **kwargs: tool_run_python(code=code),
}

TOOLS = [
    {
        "type": "function",
        "name": "read_memory",
        "description": "Load all JSON memory files from controller/memory.",
        "parameters": {"type": "object", "properties": {}, "additionalProperties": False},
